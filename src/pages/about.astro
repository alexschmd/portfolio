---
import BaseLayout from "../layouts/BaseLayout.astro";
import GitGraph from "../components/GitGraph.astro";

const title = "Über mich · Alexander Schmid";
const description = "Mein Werdegang zwischen Softwareentwicklung, Studium und Ehrenamt – erzählt als Git-Historie.";
---

<BaseLayout
  title={title}
  description={description}
>
  <div class="mx-auto w-full max-w-3xl select-none px-6 pt-16">
    <header
      class="mb-8 opacity-0 animate-fade-in-up"
      style="animation-delay: 0s;"
    >
      <h1 class="text-2xl tracking-tight text-text">Über mich</h1>
    </header>
    <GitGraph />
  </div>
</BaseLayout>
