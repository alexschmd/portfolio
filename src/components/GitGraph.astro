---
import { GIT_GRAPH_BRANCH_COLORS as colors } from "../lib/gitGraphPalette";

const [blue, purple, pink, red, orange, green, teal] = colors;
const startYear = 2015;
const endYear = new Date().getFullYear();
const top = 100;
const yearGap = 240;
const bottom = top + (endYear - startYear) * yearGap + 180;
const y = (year: number, offset = 0) =>
  top + (year - startYear) * yearGap + offset;
const years = Array.from(
  { length: endYear - startYear + 1 },
  (_, index) => startYear + index,
);

const branches = [
  {
    label: "school",
    title: "Schule",
    period: "2015–2023",
    description:
      "Mein schulischer Weg bis zum Abitur – mit den ersten Projekten und dem Einstieg in die Softwareentwicklung.",
    color: purple,
    x: 100,
    start: y(2015, 40),
    end: y(2023, 90),
    merged: true,
  },
  {
    label: "internship",
    title: "Praktikum",
    period: "2021",
    description:
      "Ein erster konzentrierter Einblick in den beruflichen Alltag und die praktische Arbeit außerhalb der Schule.",
    color: pink,
    x: 155,
    start: y(2021, 70),
    end: y(2021, 170),
    merged: true,
  },
  {
    label: "TZ",
    title: "Technisches Zeichnen",
    period: "Seit 2021",
    description:
      "Ein fortlaufender Weg zwischen technischem Verständnis, präziser Planung und praktischer Umsetzung.",
    color: teal,
    x: 210,
    start: y(2021, 15),
    end: bottom,
    merged: false,
  },
  {
    label: "messdiener",
    title: "Messdiener",
    period: "Seit 2023",
    description:
      "Ehrenamtliches Engagement, Gemeinschaft und die Verantwortung für gemeinsame Aktionen und Veranstaltungen.",
    color: green,
    x: 265,
    start: y(2023, 20),
    end: bottom,
    merged: false,
  },
  {
    label: "work",
    title: "Beruf",
    period: "Seit 2023",
    description:
      "Meine berufliche Entwicklung in der Softwareentwicklung und die Arbeit an echten Produkten und Prozessen.",
    color: red,
    x: 320,
    start: y(2023, 130),
    end: bottom,
    merged: false,
  },
  {
    label: "uni",
    title: "Studium",
    period: "Seit 2023",
    description:
      "Mein Studium als fachliche Ergänzung zur Praxis – mit neuen Perspektiven auf Informatik und Softwareentwicklung.",
    color: orange,
    x: 375,
    start: y(2023, 155),
    end: bottom,
    merged: false,
  },
  {
    label: "sternsinger",
    title: "Sternsinger",
    period: "Seit 2024",
    description:
      "Organisation und Unterstützung der Sternsinger-Aktion als weiterer Teil meines ehrenamtlichen Engagements.",
    color: purple,
    x: 430,
    start: y(2024, 35),
    end: bottom,
    merged: false,
  },
];

const mergedBranchInset = (branch: (typeof branches)[number]) =>
  Math.min(90, (branch.end - branch.start) / 3);
const branchStartNodeY = (branch: (typeof branches)[number]) =>
  branch.start + (branch.merged ? mergedBranchInset(branch) : 90);
const branchEndNodeY = (branch: (typeof branches)[number]) =>
  branch.merged ? branch.end - mergedBranchInset(branch) : branch.end - 20;
const isShortMergedBranch = (branch: (typeof branches)[number]) =>
  branch.merged && branch.end - branch.start < 180;
const branchLabelX = (branch: (typeof branches)[number]) =>
  isShortMergedBranch(branch) ? branch.x : branch.x + 14;
const branchLabelY = (branch: (typeof branches)[number]) =>
  isShortMergedBranch(branch)
    ? branchEndNodeY(branch) + 20
    : branchStartNodeY(branch) + 4;
const branchLabelRevealY = (branch: (typeof branches)[number]) =>
  isShortMergedBranch(branch)
    ? branchEndNodeY(branch)
    : branchStartNodeY(branch);
const branchLabelWidth = (branch: (typeof branches)[number]) =>
  branch.label.length * 7.2 + 16;
const branchLabelBackgroundX = (branch: (typeof branches)[number]) =>
  isShortMergedBranch(branch)
    ? branchLabelX(branch) - branchLabelWidth(branch) / 2
    : branchLabelX(branch) - 8;
const branchPath = (branch: (typeof branches)[number]) => {
  if (!branch.merged) {
    return `M40 ${branch.start} C40 ${branch.start + 42} ${branch.x} ${branch.start + 42} ${branch.x} ${branch.start + 90} V${branch.end}`;
  }

  const inset = mergedBranchInset(branch);
  const curve = Math.min(42, inset);
  const outboundY = branch.start + inset;
  const inboundY = branch.end - inset;

  return `M40 ${branch.start} C40 ${branch.start + curve} ${branch.x} ${outboundY - curve} ${branch.x} ${outboundY} V${inboundY} C${branch.x} ${inboundY + curve} 40 ${branch.end - curve} 40 ${branch.end}`;
};
---

<div
  class="git-graph"
  data-git-graph
  aria-label="Mein Werdegang als Git-Graph"
  style={`--graph-height:${bottom}px`}
>
  <svg
    viewBox={`0 0 560 ${bottom}`}
    width="560"
    height={bottom}
    aria-hidden="true"
  >
    <defs>
      <clipPath id="graph-progress-clip">
        <rect data-progress-clip x="0" y="0" width="560" height="0"></rect>
      </clipPath>
    </defs>

    <g
      fill="none"
      stroke-width="4"
      stroke-linecap="round"
      stroke-linejoin="round"
      clip-path="url(#graph-progress-clip)"
    >
      <path data-draw-path stroke={blue} d={`M40 0 V${bottom}`}></path>

      {
        branches.map((branch) => (
          <path data-draw-path stroke={branch.color} d={branchPath(branch)} />
        ))
      }
    </g>

    <g stroke="#050505" stroke-width="4">
      {
        years.map((year) => (
          <circle
            data-reveal-y={y(year)}
            cx="40"
            cy={y(year)}
            r="8"
            fill={blue}
          />
        ))
      }
      {
        branches.map((branch) => (
          <circle
            data-reveal-y={branch.start}
            cx="40"
            cy={branch.start}
            r="6"
            fill="#050505"
            stroke={branch.color}
            stroke-width="2.5"
          />
        ))
      }
      {
        branches
          .filter((branch) => branch.merged)
          .map((branch) => (
            <circle
              data-reveal-y={branch.end}
              cx="40"
              cy={branch.end}
              r="6"
              fill="#050505"
              stroke={branch.color}
              stroke-width="2.5"
            />
          ))
      }
      {
        branches.map((branch, branchIndex) => (
          <>
            <circle
              data-reveal-path={branchIndex}
              data-reveal-path-y={branchStartNodeY(branch)}
              cx={branch.x}
              cy={branchStartNodeY(branch)}
              r="8"
              fill={branch.color}
            />
            <circle
              data-reveal-path={branchIndex}
              data-reveal-path-y={branchEndNodeY(branch)}
              cx={branch.x}
              cy={branchEndNodeY(branch)}
              r="8"
              fill={branch.color}
            />
          </>
        ))
      }
    </g>

    <g class="year-labels">
      {
        years.map((year) => (
          <text
            data-reveal-y={y(year)}
            x="16"
            y={y(year) + 4}
            text-anchor="end"
          >
            {year}
          </text>
        ))
      }
    </g>

    <g class="branch-labels">
      {
        branches.map((branch, branchIndex) => (
          <g
            class="branch-label-trigger"
            data-reveal-path={branchIndex}
            data-reveal-path-y={branchLabelRevealY(branch)}
            data-branch-trigger
            data-branch-label={branch.label}
            data-branch-title={branch.title}
            data-branch-period={branch.period}
            data-branch-description={branch.description}
            data-branch-color={branch.color}
            role="button"
            tabindex="0"
            aria-label={`Mehr über ${branch.title} erfahren`}
            aria-expanded="false"
          >
            <rect
              class="branch-label-background"
              x={branchLabelBackgroundX(branch)}
              y={branchLabelY(branch) - 16}
              width={branchLabelWidth(branch)}
              height="24"
              rx="6"
            />
            <text
              x={branchLabelX(branch)}
              y={branchLabelY(branch)}
              text-anchor={isShortMergedBranch(branch) ? "middle" : "start"}
              fill={branch.color}
            >
              {branch.label}
            </text>
          </g>
        ))
      }
    </g>
  </svg>
</div>

<aside
  class="branch-popover"
  data-branch-popover
  data-state="closed"
  hidden
  aria-live="polite"
  aria-label="Branch-Details"
>
  <h2 data-branch-popover-title></h2>
  <div class="branch-popover-details">
    <span class="branch-popover-period" data-branch-popover-period></span>
    <p data-branch-popover-description></p>
  </div>
</aside>

<script>
  const setupGitGraph = () => {
    const graph = document.querySelector<HTMLElement>("[data-git-graph]");
    if (!graph || graph.dataset.ready === "true") return;

    graph.dataset.ready = "true";
    let frame = 0;
    const popover = document.querySelector<HTMLElement>(
      "[data-branch-popover]",
    );
    let activeTrigger: SVGElement | null = null;
    let closeTimer = 0;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let activeTriggerNextSibling: ChildNode | null = null;

    const restoreActiveTriggerOrder = () => {
      if (!activeTrigger?.parentNode) return;
      activeTrigger.parentNode.insertBefore(
        activeTrigger,
        activeTriggerNextSibling,
      );
      activeTriggerNextSibling = null;
    };

    const closeBranchPopover = (restoreFocus = false) => {
      if (!popover || popover.hidden) return;
      popover.dataset.state = "closed";
      activeTrigger?.classList.remove("is-expanded");
      activeTrigger?.setAttribute("aria-expanded", "false");
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(
        () => {
          popover.hidden = true;
          restoreActiveTriggerOrder();
          if (restoreFocus) activeTrigger?.focus();
          activeTrigger = null;
        },
        reducedMotion.matches ? 0 : 260,
      );
    };

    const hideBranchPopoverImmediately = () => {
      if (!popover || popover.hidden) return;
      window.clearTimeout(closeTimer);
      popover.dataset.state = "closed";
      popover.hidden = true;
      activeTrigger?.classList.remove("is-expanded");
      activeTrigger?.setAttribute("aria-expanded", "false");
      restoreActiveTriggerOrder();
      activeTrigger = null;
    };

    const openBranchPopover = (trigger: SVGElement) => {
      if (!popover) return;
      window.clearTimeout(closeTimer);
      activeTrigger?.classList.remove("is-expanded");
      activeTrigger?.setAttribute("aria-expanded", "false");
      restoreActiveTriggerOrder();

      const title = popover.querySelector<HTMLElement>(
        "[data-branch-popover-title]",
      );
      const period = popover.querySelector<HTMLElement>(
        "[data-branch-popover-period]",
      );
      const description = popover.querySelector<HTMLElement>(
        "[data-branch-popover-description]",
      );

      if (title) {
        title.textContent = trigger.dataset.branchLabel ?? "";
        title.style.color = trigger.dataset.branchColor ?? "";
      }
      if (period) period.textContent = trigger.dataset.branchPeriod ?? "";
      if (description)
        description.textContent = trigger.dataset.branchDescription ?? "";

      const triggerBounds = trigger.getBoundingClientRect();
      const left = triggerBounds.left;
      const availableWidth = window.innerWidth - left - 16;
      const width = Math.max(
        triggerBounds.width,
        Math.min(340, availableWidth),
      );

      popover.style.width = `${width}px`;
      popover.style.left = `${left + window.scrollX}px`;
      popover.style.top = `${triggerBounds.top + window.scrollY}px`;
      popover.style.setProperty("--tag-height", `${triggerBounds.height}px`);
      popover.hidden = false;
      popover.dataset.state = "closed";

      const popoverBounds = popover.getBoundingClientRect();
      const svg = trigger.ownerSVGElement;
      const matrix = svg?.getScreenCTM();
      const scaleX = matrix ? Math.hypot(matrix.a, matrix.b) : 1;
      const scaleY = matrix ? Math.hypot(matrix.c, matrix.d) : 1;
      trigger.style.setProperty(
        "--expanded-tag-width",
        `${popoverBounds.width / scaleX}px`,
      );
      trigger.style.setProperty(
        "--expanded-tag-height",
        `${popoverBounds.height / scaleY}px`,
      );
      popover.style.setProperty(
        "--morph-right",
        `${Math.max(0, popoverBounds.width - triggerBounds.width)}px`,
      );
      popover.style.setProperty(
        "--morph-bottom",
        `${popoverBounds.height}px`,
      );

      activeTrigger = trigger;
      activeTriggerNextSibling = trigger.nextSibling;
      trigger.parentNode?.appendChild(trigger);
      trigger.setAttribute("aria-expanded", "true");
      // Commit the small, reordered tag before starting the geometry transition.
      trigger.getBoundingClientRect();
      window.requestAnimationFrame(() => {
        if (activeTrigger !== trigger) return;
        trigger.classList.add("is-expanded");
        popover.dataset.state = "open";
      });
    };

    const toggleBranchPopover = (
      trigger: SVGElement,
      restoreFocusOnClose = false,
    ) => {
      if (activeTrigger === trigger && popover?.dataset.state === "open") {
        closeBranchPopover(restoreFocusOnClose);
        return;
      }

      openBranchPopover(trigger);
    };

    graph
      .querySelectorAll<SVGElement>("[data-branch-trigger]")
      .forEach((trigger) => {
        trigger.addEventListener("click", (event) => {
          event.stopPropagation();
          toggleBranchPopover(trigger);
        });
        trigger.addEventListener("keydown", (event) => {
          if (event.key !== "Enter" && event.key !== " ") return;
          event.preventDefault();
          toggleBranchPopover(trigger, true);
        });
      });

    popover?.addEventListener("click", (event) => event.stopPropagation());
    document.addEventListener("click", () => closeBranchPopover());
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeBranchPopover(true);
    });
    window.addEventListener("resize", () => closeBranchPopover(), {
      passive: true,
    });

    const update = () => {
      frame = 0;
      const bounds = graph.getBoundingClientRect();
      const isAtPageEnd =
        window.innerHeight + window.scrollY >=
        document.documentElement.scrollHeight - 1;
      const drawnHeight = isAtPageEnd
        ? bounds.height
        : Math.max(
            0,
            Math.min(bounds.height, window.innerHeight * 0.96 - bounds.top),
          );

      graph
        .querySelector<SVGRectElement>("[data-progress-clip]")
        ?.setAttribute("height", String(drawnHeight));

      const paths = Array.from(
        graph.querySelectorAll<SVGPathElement>("[data-draw-path]"),
      );
      const revealedLengths: number[] = [];

      paths.forEach((path) => {
        const length = path.getTotalLength();
        const box = path.getBBox();
        const progress =
          box.height === 0
            ? Number(drawnHeight >= box.y)
            : Math.max(0, Math.min(1, (drawnHeight - box.y) / box.height));
        const revealedLength = length * progress;

        path.style.strokeDasharray = `${length}`;
        path.style.strokeDashoffset = `${length - revealedLength}`;
        revealedLengths.push(revealedLength);
      });

      graph
        .querySelectorAll<SVGElement>("[data-reveal-y]")
        .forEach((element) => {
          const elementY = Number(element.dataset.revealY ?? 0);
          element.classList.toggle("is-visible", elementY <= drawnHeight);
        });

      graph
        .querySelectorAll<SVGElement>("[data-reveal-path]")
        .forEach((element) => {
          const branchIndex = Number(element.dataset.revealPath ?? 0);
          const path = paths[branchIndex + 1];
          if (!path) return;

          let targetLength = Number(element.dataset.revealLength);
          if (!Number.isFinite(targetLength)) {
            const targetY = Number(element.dataset.revealPathY ?? 0);
            let low = 0;
            let high = path.getTotalLength();

            for (let step = 0; step < 14; step++) {
              const middle = (low + high) / 2;
              if (path.getPointAtLength(middle).y <= targetY) {
                low = middle;
              } else {
                high = middle;
              }
            }

            targetLength = low;
            element.dataset.revealLength = String(targetLength);
          }

          element.classList.toggle(
            "is-visible",
            Number(element.dataset.revealPathY ?? 0) <= drawnHeight &&
              revealedLengths[branchIndex + 1] >= targetLength,
          );
        });

      if (activeTrigger && !activeTrigger.classList.contains("is-visible")) {
        hideBranchPopoverImmediately();
      }
    };

    const requestUpdate = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(update);
    };

    update();
    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", requestUpdate, { passive: true });
  };

  setupGitGraph();
  document.addEventListener("astro:page-load", setupGitGraph);
</script>

<style>
  .git-graph {
    position: relative;
    width: 560px;
    max-width: 100%;
    height: var(--graph-height);
  }
  svg {
    display: block;
    width: 560px;
    height: var(--graph-height);
    overflow: visible;
  }
  :is([data-reveal-y], [data-reveal-path]) {
    opacity: 0;
    transition: opacity 120ms ease-out;
  }
  :is([data-reveal-y], [data-reveal-path]).is-visible {
    opacity: 1;
  }
  .year-labels {
    fill: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .branch-labels {
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .branch-label-trigger {
    cursor: pointer;
    outline: none;
    user-select: none;
  }
  .branch-label-trigger:focus-visible .branch-label-background {
    stroke: color-mix(in oklab, var(--color-accent) 60%, transparent);
    stroke-width: 2;
  }
  .branch-label-trigger.is-expanded .branch-label-background {
    width: var(--expanded-tag-width);
    height: var(--expanded-tag-height);
  }
  .branch-label-background {
    fill: var(--color-void);
    fill-opacity: 0.95;
    stroke: color-mix(in oklab, white 10%, transparent);
    transition:
      width 260ms cubic-bezier(0.32, 0.72, 0, 1),
      height 260ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .branch-popover {
    --morph-right: 0px;
    --morph-bottom: 0px;
    --tag-height: 24px;
    box-sizing: border-box;
    position: absolute;
    z-index: 80;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    padding: calc(var(--tag-height) - 0.25rem) 0.5rem 0.5rem;
    color: var(--color-text);
    border: 0;
    border-radius: 0.4rem;
    background: transparent;
    transform-origin: top left;
    transition:
      clip-path 260ms cubic-bezier(0.32, 0.72, 0, 1),
      border-radius 260ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .branch-popover[data-state="closed"] {
    clip-path: inset(0 var(--morph-right) var(--morph-bottom) 0 round 0.4rem);
  }
  .branch-popover[data-state="open"] {
    clip-path: inset(0 0 0 0 round 0.4rem);
  }
  .branch-popover h2 {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .branch-popover-details {
    transition:
      opacity 160ms ease-out 70ms,
      transform 200ms cubic-bezier(0.23, 1, 0.32, 1) 40ms;
  }
  .branch-popover[data-state="closed"] .branch-popover-details {
    opacity: 0;
    transform: translateY(-3px);
    transition-delay: 0ms;
  }
  .branch-popover-period {
    color: var(--color-muted);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .branch-popover p {
    margin-top: 0.25rem;
    color: var(--color-subtle);
    font-size: 0.78rem;
    line-height: 1.65;
  }
  @media (prefers-reduced-motion: reduce) {
    .branch-label-trigger,
    .branch-label-background,
    .branch-popover,
    .branch-popover-details {
      transition-duration: 0.01ms;
    }
  }
</style>
